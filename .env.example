# Model reasoning step runs on the Claude Agent SDK, against your Claude Code
# subscription -- not a separate console.anthropic.com API key.
#
# On the machine where you're already logged into `claude` (e.g. this one),
# you need NONE of this -- the SDK reuses your existing login automatically.
#
# On a different machine or in CI with no interactive login, run once:
#   claude setup-token
# then paste the printed value here:
CLAUDE_CODE_OAUTH_TOKEN=

ANTHROPIC_MODEL=claude-opus-5-5

# Claims database (agent/db.py). Defaults to the credentials in
# docker-compose.yml, so `docker compose up -d` + this default just works.
DATABASE_URL=postgresql://claims:claims@localhost:5432/claims

# Optional -- leave blank to skip Langfuse and use the local trace log only
# (logs/trace.jsonl). Get keys at https://cloud.langfuse.com after creating a project.
# Real secrets belong in .env (gitignored), never in this template file.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
